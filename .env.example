# All payload paths should point outside the Git repository in production.
RS_EVAL_DATA_ROOT=/mnt/rs-eval/data
RS_EVAL_WEIGHTS_ROOT=/mnt/rs-eval/weights
RS_EVAL_RUNS_ROOT=/mnt/rs-eval/runs
RS_EVAL_CACHE_ROOT=/mnt/rs-eval/cache

# These paths match the catalog download destinations above.
ANYSAT_CHECKPOINT=/mnt/rs-eval/weights/anysat/base/AnySat.pth
CLAY_CHECKPOINT=/mnt/rs-eval/weights/clay/v1.5/clay-v1.5.ckpt
PRITHVI_CHECKPOINT=/mnt/rs-eval/weights/prithvi/eo-v2-300m-tl/Prithvi_EO_V2_300M_TL.pt

# Portal result browsing stays read-only; these mutations only write catalog resources
# beneath RS_EVAL_DATA_ROOT and RS_EVAL_WEIGHTS_ROOT.
RS_EVAL_DOWNLOADS_ENABLED=true
RS_EVAL_PORTAL_HOST=127.0.0.1
RS_EVAL_PORTAL_PORT=8080

# Optional network proxy for the Portal and its download child processes
# (aria2c / gsutil / hf inherit these). Needed when HF/GCS are only reachable
# through a local proxy, e.g.:
# http_proxy=http://127.0.0.1:1080
# https_proxy=http://127.0.0.1:1080

# Optional for gated/private Hugging Face resources. Never commit a real token.
# HF_TOKEN=
