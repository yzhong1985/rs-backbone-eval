# Host paths mounted into the container. Defaults are the 89 deployment; on
# another machine point these at its data/weights/runs/cache.
RS_EVAL_HOST_DATA=/geodata/rs-eval/data
RS_EVAL_HOST_WEIGHTS=/geodata/rs-eval/weights
RS_EVAL_HOST_RUNS=/geodata/rs-eval/runs
RS_EVAL_HOST_QUEUE=/geodata/rs-eval/queue
RS_EVAL_HOST_TOOLS=/geodata/rs-eval/tools
RS_EVAL_HOST_CACHE=/home/yzhong/rs-eval-cache

# Build-time mirrors (byte-identical files, lock hashes still verify).
# Clear both to build against upstream PyPI / download.pytorch.org.
RS_EVAL_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/
RS_EVAL_TORCH_MIRROR=https://mirrors.aliyun.com/pytorch-wheels/

UID=1000
GID=1000
