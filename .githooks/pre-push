#!/usr/bin/env bash
# Pre-push CI gate: the review protocol requires pushing only green trees, and
# three consecutive rounds were pushed with formatting/lint issues. Runs the
# same chain CI runs; bypass with `git push --no-verify` (explicit override).
set -euo pipefail
# dirname = <repo>/.githooks; one level up is the repository root.
cd "$(dirname "$0")/.."
echo "[pre-push] ruff check ."
uv run ruff check .
echo "[pre-push] ruff format --check ."
uv run ruff format --check .
echo "[pre-push] pytest"
uv run pytest -q
echo "[pre-push] hygiene"
uv run python scripts/check_repo_hygiene.py
